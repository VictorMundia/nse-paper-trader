# Copy this file to backend/.env and fill in your own values. Never commit backend/.env.

# PostgreSQL connection template for local development
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/nse_paper_trader

# JWT signing secret template (replace in real .env)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Optional: 1 turns on Flask debug mode (auto-reload, error pages). Keep 0 for the study.
FLASK_DEBUG=0

# Optional: frontend address used in password reset links.
FRONTEND_URL=http://localhost:5173

# Optional: email for password resets. Leave MAIL_SERVER empty to print emails in the Flask console instead.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=